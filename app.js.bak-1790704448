/* ============================================================
   app.js — القرآن الكريم (نسخة احترافية)
   ============================================================ */

const surahList = document.getElementById("surahList");
const mushafView = document.getElementById("mushafView");
const mushaf = document.getElementById("mushaf");
const readerSelect = document.getElementById("readerSelect");

/* جدول تحويل القراء إلى مصادر الصوت */
const READER_SOURCES = {
  "ar.alafasy":            { source: "islamic", id: "ar.alafasy" },
  "ar.abdulbasitmurattal": { source: "everyayah", id: "Abdul_Basit_Murattal_192kbps" },
  "ar.abdurrahmaansudais": { source: "everyayah", id: "Abdurrahmaan_As-Sudais_192kbps" },
  "ar.abdullahbasfar":     { source: "everyayah", id: "Abdullah_Basfar_192kbps" },
  "ar.husary":             { source: "everyayah", id: "Husary_128kbps" },
  "ar.minshawi":           { source: "everyayah", id: "Minshawy_Murattal_128kbps" },
  "ar.muhammadjibreel":    { source: "everyayah", id: "Muhammad_Jibreel_128kbps" },
  "ar.mahermuaiqly":       { source: "everyayah", id: "Maher_AlMuaiqly_128kbps" },
  "ar.shaatree":           { source: "everyayah", id: "Abu_Bakr_Ash-Shaatree_128kbps" },
  "ar.hudhaify":           { source: "everyayah", id: "Hudhaify_128kbps" },
  "ar.ahmedajamy":         { source: "everyayah", id: "Ahmed_ibn_Ali_al-Ajamy_128kbps" },
  "ar.hanirifai":          { source: "everyayah", id: "Hani_Rifai_192kbps" },
  "ar.muhammadayyoub":     { source: "everyayah", id: "Muhammad_Ayyoub_128kbps" },
  "ar.aymanswoaid":        { source: "everyayah", id: "Ayman_Sowaid_64kbps" }
};

function buildAudioURL(readerId, globalAyahNum) {
  var info = READER_SOURCES[readerId] || READER_SOURCES["ar.alafasy"];
  var padded = String(globalAyahNum).padStart(6, "0");
  if (info.source === "everyayah") {
    return "https://everyayah.com/data/" + info.id + "/" + padded + ".mp3";
  }
  return "https://cdn.islamic.network/quran/audio/128/" + info.id + "/" + globalAyahNum + ".mp3";
}

const search = document.getElementById("search");
const searchSurah = document.getElementById("searchSurah");
const progress = document.getElementById("progress");
const currentTimeEl = document.getElementById("currentTime");
const durationEl = document.getElementById("duration");
const playBtn = document.getElementById("playBtn");

let ayahs = [];
let currentIndex = 0;
let currentSurah = null;
let audio = new Audio();
let isPlaying = false;
let localQuran = null;
let bookmarks = JSON.parse(localStorage.getItem("bookmarks") || "[]");

/* ============================================================
   تشغيل التطبيق (زر ابدأ الآن)
   ============================================================ */
function startApp() {
  document.getElementById("cover").classList.add("hidden");
  setTimeout(() => {
    document.getElementById("header").style.display = "flex";
    document.getElementById("mushaf").style.display = "block";
    document.getElementById("player").style.display = "block";

    // استرجاع آخر سورة
    const lastSurah = localStorage.getItem("lastSurah");
    const lastReader = localStorage.getItem("lastReader");
    if (lastReader) readerSelect.value = lastReader;

    loadSurahList().then(() => {
      if (lastSurah) {
        loadSurah(parseInt(lastSurah));
      }
    });
  }, 600);
}

/* ============================================================
   Sidebar (قائمة السور)
   ============================================================ */
function toggleSidebar() {
  const sidebar = document.getElementById("sidebar");
  const overlay = document.getElementById("overlay");
  sidebar.classList.toggle("open");
  overlay.classList.toggle("show");
}

/* ============================================================
   الوضع الليلي
   ============================================================ */
function toggleTheme() {
  document.body.classList.toggle("light-mode");
  const isLight = document.body.classList.contains("light-mode");
  document.getElementById("settingsBtn").textContent = isLight ? "☀️" : "🌙";
  localStorage.setItem("theme", isLight ? "light" : "dark");
}

/* ============================================================
   1. تحميل قائمة السور
   ============================================================ */
async function loadSurahList() {
  surahList.innerHTML = "<p style='text-align:center;color:#FFD700;padding:20px'>جاري التحميل...</p>";

  if (navigator.onLine) {
    try {
      const res = await fetch("https://api.alquran.cloud/v1/surah");
      const data = await res.json();
      displaySurahList(data.data.map(s => ({
        number: s.number,
        name: s.name,
        englishName: s.englishName,
        ayahCount: s.numberOfAyahs,
        type: s.revelationType === "Meccan" ? "مكية" : "مدنية"
      })));
      return;
    } catch (e) {
      console.warn("API فشل، استخدام quran.json");
    }
  }

  try {
    await loadLocalQuran();
    if (localQuran && localQuran.length > 0) {
      displaySurahList(localQuran.map(s => ({
        number: s.id || s.number,
        name: s.name,
        ayahCount: (s.ayahs || s.verses || []).length,
        type: s.type || ""
      })));
    }
  } catch (e) {
    surahList.innerHTML = "<p style='color:red;padding:20px'>❌ فشل التحميل</p>";
  }
}

/* ============================================================
   2. عرض قائمة السور
   ============================================================ */
function displaySurahList(surahs) {
  surahList.innerHTML = "";
  surahs.forEach(surah => {
    const btn = document.createElement("button");
    btn.className = "surah-item";
    btn.dataset.num = surah.number;
    btn.innerHTML = `<span>${surah.name}</span><span class="num">${surah.number}</span>`;
    btn.onclick = () => {
      loadSurah(surah.number);
      toggleSidebar();
    };
    surahList.appendChild(btn);
  });
}

/* ============================================================
   3. تحميل سورة
   ============================================================ */
async function loadSurah(num) {
  currentSurah = num;
  mushafView.innerHTML = "<div style='text-align:center;padding:40px'><div class='spinner'></div><br>جاري التحميل...</div>";

  // تحديث الحالة النشطة في القائمة
  document.querySelectorAll(".surah-item").forEach(el => el.classList.remove("active"));
  const activeItem = document.querySelector(`.surah-item[data-num="${num}"]`);
  if (activeItem) activeItem.classList.add("active");

  localStorage.setItem("lastSurah", num);
  localStorage.setItem("lastReader", readerSelect.value);

  if (navigator.onLine) {
    try {
      const res = await fetch(`https://api.alquran.cloud/v1/surah/${num}/${readerSelect.value}`);
      const data = await res.json();
      ayahs = data.data.ayahs;
      currentIndex = 0;
      displayAyahs(data.data);
      return;
    } catch (e) {
      console.warn("API فشل");
    }
  }

  try {
    await loadLocalQuran();
    const surah = localQuran.find(s => (s.id || s.number) === num);
    if (!surah) {
      mushafView.innerHTML = "<h2>❌ السورة غير موجودة</h2>";
      return;
    }
    ayahs = (surah.ayahs || surah.verses || []).map((a, i) => ({
      text: a.text || a.arabicText || a,
      numberInSurah: a.numberInSurah || i + 1
    }));
    currentIndex = 0;
    displayAyahs(surah);
  } catch (e) {
    mushafView.innerHTML = "<h2>❌ فشل التحميل</h2>";
  }
}

/* ============================================================
   4. quran.json المحلي
   ============================================================ */
async function loadLocalQuran() {
  if (localQuran) return localQuran;
  const res = await fetch("quran.json");
  const data = await res.json();
  localQuran = Array.isArray(data) ? data : (data.data || data.surahs || []);
  return localQuran;
}

/* ============================================================
   5. عرض الآيات
   ============================================================ */
function displayAyahs(surahInfo) {
  mushafView.innerHTML = "";

  // رأس السورة
  const header = document.createElement("div");
  header.className = "surah-header";
  header.innerHTML = `
    <h2>سورة ${surahInfo.name || ""}</h2>
    <div class="info">${surahInfo.revelationType === "Meccan" ? "مكية" : surahInfo.revelationType === "Medinan" ? "مدنية" : ""} • ${ayahs.length} آية</div>
  `;
  mushafView.appendChild(header);

  // البسملة (إلا في التوبة والفاتحة)
  if (currentSurah !== 1 && currentSurah !== 9) {
    const bism = document.createElement("div");
    bism.className = "bismillah";
    bism.textContent = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ";
    mushafView.appendChild(bism);
  }

  // الآيات
  ayahs.forEach((ayah, index) => {
    const div = document.createElement("div");
    div.className = "ayah";
    div.dataset.index = index;

    const isBookmarked = bookmarks.some(b => b.surah === currentSurah && b.ayah === ayah.numberInSurah);
    div.innerHTML = `
      <span class="bookmark ${isBookmarked ? 'active' : ''}">${isBookmarked ? '🔖' : ''}</span>
      ${ayah.text}
      <span class="num">${ayah.numberInSurah}</span>
      <div style="margin-top:8px;display:flex;gap:8px;justify-content:flex-end">
        <button onclick="event.stopPropagation(); openTafsir(${currentSurah}, ${ayah.numberInSurah})" style="background:rgba(255,215,0,0.15);border:1px solid rgba(255,215,0,0.3);color:#FFD700;padding:4px 10px;border-radius:8px;font-size:12px;cursor:pointer;font-family:Tajawal">📚 تفسير</button>
        <button onclick="event.stopPropagation(); shareAyah('${typeof surahInfo !== "undefined" && surahInfo ? surahInfo.name : ""}', ${ayah.numberInSurah}, '${ayah.text.replace(/'/g, "\\'")}')" style="background:rgba(255,215,0,0.15);border:1px solid rgba(255,215,0,0.3);color:#FFD700;padding:4px 10px;border-radius:8px;font-size:12px;cursor:pointer;font-family:Tajawal">📤 مشاركة</button>
      </div>
    `;
    // ضغطة قصيرة: تشغيل
    let pressTimer;
    div.addEventListener("touchstart", () => {
      pressTimer = setTimeout(() => {
        toggleBookmark(currentSurah, ayah.numberInSurah, div);
      }, 600);
    });
    div.addEventListener("touchend", () => clearTimeout(pressTimer));
    div.addEventListener("click", () => {
      document.querySelectorAll(".ayah.active").forEach(el => el.classList.remove("active"));
      div.classList.add("active");
      currentIndex = index;
      playAyah();
    });

    mushafView.appendChild(div);
  });
}

/* ============================================================
   6. الإشارات المرجعية
   ============================================================ */
function toggleBookmark(surah, ayah, el) {
  const idx = bookmarks.findIndex(b => b.surah === surah && b.ayah === ayah);
  if (idx >= 0) {
    bookmarks.splice(idx, 1);
    el.querySelector(".bookmark").textContent = "";
    el.querySelector(".bookmark").classList.remove("active");
  } else {
    bookmarks.push({ surah, ayah });
    el.querySelector(".bookmark").textContent = "🔖";
    el.querySelector(".bookmark").classList.add("active");
  }
  localStorage.setItem("bookmarks", JSON.stringify(bookmarks));
}

/* ============================================================
   7. تشغيل الآية
   ============================================================ */
function playAyah() {
  if (!navigator.onLine) {
    alert("⚠️ التلاوة تحتاج إنترنت");
    return;
  }
  if (!ayahs[currentIndex]) return;

  const ayahNum = ayahs[currentIndex].numberInSurah;
  const globalAyahNum = getGlobalAyahNumber(currentSurah, ayahNum);
  const reader = (typeof getSettings === "function" ? getSettings().reader : readerSelect.value);
  const url = buildAudioURL(reader, globalAyahNum);

  audio.src = url;
  audio.play().catch(e => console.warn("خطأ الصوت:", e));
  isPlaying = true;
  if (playBtn) playBtn.textContent = "⏸";
}

function getGlobalAyahNumber(surahNum, ayahNum) {
  // ترتيب تراكمي لعدد الآيات في كل سورة
  const surahAyahCounts = [7,286,200,176,120,165,206,75,129,109,123,111,43,52,99,128,111,110,98,135,112,78,118,64,77,227,93,88,69,60,34,30,73,54,45,83,182,88,75,85,54,53,89,59,37,35,38,29,18,45,60,49,62,55,78,96,29,22,24,13,14,11,11,18,12,12,30,52,52,44,28,28,20,56,40,31,50,40,46,42,29,19,36,25,22,17,19,26,30,20,15,21,11,8,8,19,5,8,8,11,11,8,3,9,5,4,7,3,6,3,5,4,5,6];
  let total = 0;
  for (let i = 0; i < surahNum - 1; i++) total += surahAyahCounts[i];
  return total + ayahNum;
}

/* ============================================================
   8. التحكم
   ============================================================ */
function prevAyah() {
  if (currentIndex > 0) { currentIndex--; playAyah(); scrollToAyah(currentIndex); }
}
function nextAyah() {
  if (currentIndex < ayahs.length - 1) { currentIndex++; playAyah(); scrollToAyah(currentIndex); }
}
function togglePlay() {
  if (audio.paused) audio.play();
  else audio.pause();
}
function scrollToAyah(index) {
  const el = document.querySelector(`.ayah[data-index="${index}"]`);
  if (el) el.scrollIntoView({ behavior: "smooth", block: "center" });
}

audio.onplay = () => { if (playBtn) playBtn.textContent = "⏸"; };
audio.onpause = () => { if (playBtn) playBtn.textContent = "▶"; };
audio.onended = () => nextAyah();
audio.ontimeupdate = () => {
  if (audio.duration && progress) progress.value = (audio.currentTime / audio.duration) * 100;
  if (currentTimeEl) currentTimeEl.textContent = formatTime(audio.currentTime);
  if (durationEl) durationEl.textContent = formatTime(audio.duration);
};
if (progress) {
  progress.oninput = () => {
    if (audio.duration) audio.currentTime = (progress.value / 100) * audio.duration;
  };
}

/* ============================================================
   9. البحث في أسماء السور
   ============================================================ */
if (searchSurah) {
  searchSurah.addEventListener("input", () => {
    const val = searchSurah.value.trim();
    document.querySelectorAll(".surah-item").forEach(el => {
      el.style.display = el.textContent.includes(val) ? "flex" : "none";
    });
  });
}

/* ============================================================
   10. تنسيق الوقت
   ============================================================ */
function formatTime(t) {
  if (!t) return "0:00";
  const m = Math.floor(t / 60);
  const s = Math.floor(t % 60);
  return `${m}:${s < 10 ? "0" : ""}${s}`;
}

/* ============================================================
   11. استرجاع الوضع الليلي
   ============================================================ */
if (localStorage.getItem("theme") === "light") {
  document.body.classList.add("light-mode");
  const btn = document.getElementById("settingsBtn");
  if (btn) btn.textContent = "☀️";
}

